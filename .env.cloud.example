# Copy to .env.cloud locally; set the same values in Render Environment.
# Never upload .env or .env.cloud to GitHub.
BOT_TOKEN=YOUR_BOTFATHER_TOKEN
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_DATABASE_READ_WRITE_TOKEN
# Generate distinct random values with: python cloud_setup.py --secrets
WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET_32_CHARACTERS_OR_MORE
MAINTENANCE_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_32_CHARACTERS_OR_MORE
CONFIG_PATH=config.hosted.json
# Render uses RENDER_EXTERNAL_URL automatically. Set this for local setup:
PUBLIC_BASE_URL=https://YOUR_SERVICE.onrender.com
